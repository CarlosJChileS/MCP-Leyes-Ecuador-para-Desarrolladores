{
  "name": "leyes-ecuador-dev-mcp",
  "version": "1.0.3",
  "description": "MCP de gobernanza de datos y leyes tecnológicas del Ecuador para desarrolladores",
  "license": "MIT",
  "author": "Carlos Chile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosJChileS/leyes-ecuador-dev-mcp.git"
  },
  "bin": {
    "leyes-ecuador-dev-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "data/normativa.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/release-readiness.md",
    "docs/catalog-review.md",
    "docs/clients.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "catalog:discover": "tsx src/discover.ts",
    "catalog:verify": "tsx src/verify.ts",
    "catalog:import": "tsx src/import-catalog.ts",
    "catalog:review": "tsx src/review-catalog.ts",
    "catalog:coverage": "tsx src/coverage.ts",
    "catalog:legal-review": "tsx src/legal-review.ts",
    "pretest": "npm run build",
    "test": "vitest",
    "check": "npm test -- --run",
    "prepack": "npm run build",
    "verify:package": "node scripts/check-package.mjs",
    "verify:scanners": "node scripts/check-scanners.mjs",
    "verify:all": "npm run check && npm run verify:package && npm run verify:scanners",
    "checksum": "node scripts/checksum-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "pdf-lib": "1.17.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
